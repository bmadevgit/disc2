{% extends 'layout.html.twig' %}
{% block title %}{{ title }} · DISC{% endblock %}
{% block content %}
    <section class="card hero">
        <div>
            <a href="{{ path('case_detail', {id: caseId, page: 3}) }}">← กลับหน้าสอบสวน</a>
            <h1 class="section-title" style="margin-top:10px">{{ title }}</h1>
        </div>
        <button class="btn small gray" onclick="window.print()">พิมพ์ข้อมูล</button>
    </section>
    {% if app.request.query.has('saved') %}
        <div class="notice">บันทึกแล้ว
        </div>
    {% endif %}
    <section class="card">
        <h2 class="section-title">กำหนดระยะเวลา</h2>
        {% if edit %}
            <form method="post" action="{{ app.request.basePath ~ '/save_case.php' }}" class="grid" data-deadline="{{ type }}">
                <input type="hidden" name="csrf" value="{{ csrf_token('disc2_form') }}">
                <input type="hidden" name="action" value="save_track">
                <input type="hidden" name="case_id" value="{{ caseId }}">
                <input type="hidden" name="track_id" value="{{ tr.id }}">
                <input type="hidden" name="track_type" value="{{ type }}">
                {% include 'workflow/deadline.html.twig' with {track:tr, editableDays:false} %}
                <div class="actions wide">
                    <button class="btn green">บันทึกกำหนดเวลา</button>
                </div>
            </form>
        {% else %}
            <p>วันเริ่มนับ {{ tr.start_date ?: 'ยังไม่ระบุ' }} · {{ days }} วัน · ครบกำหนด {{ tr.due_date ?: 'ยังไม่ระบุ' }}</p>
        {% endif %}
        {% if edit and days == 180 %}
            <details>
                <summary>ตรวจสอบการปรับระยะเวลาเดิมเป็น 120 วัน</summary>
                <p>วันเริ่มนับ {{ tr.start_date ?: 'ยังไม่ระบุ' }} → {{ (preview.startDate ?? '') ?: 'ยังไม่ระบุ' }}</p>
                <p>วันครบกำหนด {{ tr.due_date ?: 'ยังไม่ระบุ' }} → {{ (preview.dueDate ?? '') ?: 'ยังไม่ระบุ' }}</p>
                {% if ext %}
                    <table>
                        <thead>
                            <tr>
                                <th>ขยายครั้งที่</th>
                                <th>ครบกำหนดเดิม</th>
                                <th>ครบกำหนดหลังปรับ</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for key, extension in ext %}
                                <tr>
                                    <td>{{ extension.sequence_no }}</td>
                                    <td>{{ ext[key].new_due_date }}</td>
                                    <td>{{ preview.extensions[key].new_due_date ?? '' }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
                <form method="post" action="{{ app.request.basePath ~ '/save_case.php' }}" class="grid">
                    <input type="hidden" name="csrf" value="{{ csrf_token('disc2_form') }}">
                    <input type="hidden" name="action" value="convert_serious_deadline">
                    <input type="hidden" name="track_type" value="{{ type }}">
                    <input type="hidden" name="case_id" value="{{ caseId }}">
                    <input type="hidden" name="track_id" value="{{ tr.id }}">
                    <input type="hidden" name="revision" value="{{ revision }}">
                    <div>
                        <label>เหตุผลที่ปรับระยะเวลา
                        <input name="reason" required></label>
                    </div>
                    <div class="actions">
                        <button class="btn green">ยืนยันปรับระยะเวลาเป็น 120 วัน</button>
                    </div>
                </form>
            </details>
        {% endif %}
        <p><a class="btn small" href="{{ path('discipline_results',{case_id:tr.case_id, type:tr.track_type, track_id:tr.id}) }}">ผลการสอบสวนวินัยรายบุคคล</a></p>
    </section>
    <section class="card">
        <h2 class="section-title">คำสั่งคณะกรรมการ</h2>
        {% if edit %}
            <form method="post" action="{{ app.request.basePath ~ '/save_case.php' }}" class="grid">
                <input type="hidden" name="csrf" value="{{ csrf_token('disc2_form') }}">
                <input type="hidden" name="action" value="add_order">
                <input type="hidden" name="case_id" value="{{ caseId }}">
                <input type="hidden" name="track_id" value="{{ tr.id }}">
                <div>
                    <label>รายการ</label>
                    <select name="event_type">
                        <option value="appoint">แต่งตั้ง</option>
                        <option value="change_committee">เปลี่ยนแปลงคณะกรรมการ</option>
                        <option value="amend_order">แก้ไขเพิ่มเติมคำสั่ง</option>
                    </select>
                </div>
                <div>
                    <label>วันที่คำสั่ง</label>
                    <input type="date" name="order_date">
                </div>
                <div>
                    <label>เลขคำสั่ง</label>
                    <input name="order_number">
                </div>
                <div>
                    <label>รายละเอียด</label>
                    <input name="detail">
                </div>
                <div>
                    <button class="btn small">เพิ่มรายการ</button>
                </div>
            </form>
        {% endif %}
        <table>
            <thead>
                <tr>
                    <th>รายการ</th>
                    <th>เลขคำสั่ง</th>
                    <th>วันที่</th>
                    <th>รายละเอียด</th>
                </tr>
            </thead>
            <tbody>
                {% for o in orders %}
                    <tr>
                        <td>{{ o.event_type }}</td>
                        <td>{{ o.order_number }}</td>
                        <td>{{ o.order_date }}</td>
                        <td>{{ o.detail }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </section>
    <section class="card">
        <h2 class="section-title">ขยายเวลาสอบสวน</h2>
        {% if edit %}
            <form method="post" action="{{ app.request.basePath ~ '/save_case.php' }}" class="grid">
                <input type="hidden" name="csrf" value="{{ csrf_token('disc2_form') }}">
                <input type="hidden" name="action" value="add_extension">
                <input type="hidden" name="case_id" value="{{ caseId }}">
                <input type="hidden" name="track_id" value="{{ tr.id }}">
                <div>
                    <label>จำนวนวันที่ขอขยาย</label>
                    <input type="number" name="requested_days" min="1" required>
                </div>
                <div>
                    <label>การดำเนินการที่ผ่านมา</label>
                    <input name="completed_work">
                </div>
                <div>
                    <label>เหตุผล</label>
                    <input name="reason">
                </div>
                <div>
                    <button class="btn small">เพิ่มการขยาย</button>
                </div>
            </form>
        {% endif %}
        <table>
            <thead>
                <tr>
                    <th>ครั้ง</th>
                    <th>วัน</th>
                    <th>การดำเนินการ</th>
                    <th>เหตุผล</th>
                    <th>ครบกำหนดใหม่</th>
                </tr>
            </thead>
            <tbody>
                {% for e in ext %}
                    <tr>
                        <td>{{ e.sequence_no }}</td>
                        <td>{{ e.requested_days }}</td>
                        <td>{{ e.completed_work }}</td>
                        <td>{{ e.reason }}</td>
                        <td>{{ e.new_due_date }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </section>
    <script src="{{ asset('assets/workflow.js') }}" defer></script>
{% endblock %}
