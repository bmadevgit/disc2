{% extends 'base.html.twig' %}
{% block title %}เข้าสู่ระบบ · DISC2{% endblock %}
{% block head %}
    <meta name="robots" content="noindex,nofollow">
    {% if not demo %}<link rel="stylesheet" href="{{ asset('assets/login.css') }}">{% endif %}
{% endblock %}
{% block body %}
{% if demo %}
<main class="card">
    <h1>เข้าสู่ระบบทดสอบ DISC2</h1>
    <p>ใช้บัญชีสมมติใน <code>runtime/demo-accounts.json</code> ของสำเนานี้</p>
    {% if error %}<p class="notice danger" role="alert">{{ error }}</p>{% endif %}
    <form method="post">
        <input type="hidden" name="csrf" value="{{ csrf_token('disc2_form') }}">
        <p><label>ชื่อบัญชี<input name="username" value="{{ username }}" autocomplete="username" required></label></p>
        <p><label>รหัสผ่าน<input name="password" type="password" autocomplete="current-password" required></label></p>
        <button class="btn green" type="submit">เข้าสู่ระบบ</button>
    </form>
</main>
{% else %}
<main class="card">
    <div class="logo">
        <div class="icon" aria-hidden="true">⚖</div>
        <h1>ระบบสำนวนวินัย</h1>
        <p id="login-mode-description">{{ mode == 'bma' ? 'เข้าสู่ระบบด้วย BMA Mail' : 'เข้าสู่ระบบสำหรับผู้ดูแลระบบ' }}</p>
    </div>
    {% if error %}<p class="alert" role="alert">{{ error }}</p>{% endif %}
    <nav class="tab-bar" aria-label="ประเภทบัญชี">
        <a data-mode="bma" data-description="เข้าสู่ระบบด้วย BMA Mail" class="tab{{ mode == 'bma' ? ' active' }}" href="{{ path('login') }}"{% if mode == 'bma' %} aria-current="page"{% endif %}>BMA Mail</a>
        <a data-mode="admin" data-description="เข้าสู่ระบบสำหรับผู้ดูแลระบบ" class="tab{{ mode == 'admin' ? ' active' }}" href="{{ path('login', {login_type: 'admin'}) }}"{% if mode == 'admin' %} aria-current="page"{% endif %}>ผู้ดูแลระบบ</a>
    </nav>
    <form method="post" id="form-bma" class="tab-content{{ mode == 'bma' ? ' active' }}" {% if mode != 'bma' %}hidden{% endif %}>
        <input type="hidden" name="login_type" value="bma">
        <input type="hidden" name="csrf" value="{{ csrf_token('disc2_form') }}">
        <div class="field">
            <label for="bma-username">Email (BMA Mail Username)</label>
            <div class="email-group">
                <input id="bma-username" name="username" placeholder="ชื่อผู้ใช้" value="{{ mode == 'bma' ? username : '' }}" autocomplete="username" autocapitalize="none" required>
                <span class="email-suffix">@bangkok.go.th</span>
            </div>
            <p id="email-warning" class="email-warning" aria-live="polite">ไม่ต้องพิมพ์ @bangkok.go.th ระบบจะเติมให้โดยอัตโนมัติ</p>
        </div>
        <div class="field">
            <label for="bma-password">เลขบัตรประชาชน 13 หลัก</label>
            <input id="bma-password" type="password" name="password" inputmode="numeric" maxlength="13" placeholder="กรอกเลขบัตรประชาชน 13 หลัก" autocomplete="current-password" required>
            <p class="field-note">ใช้เลขประจำตัวประชาชนที่ผูกกับบัญชี BMA Mail</p>
        </div>
        <button type="submit" class="btn">เข้าสู่ระบบ</button>
        <p class="security-note">ข้อมูลสำหรับเข้าสู่ระบบจะใช้เพื่อตรวจสอบสิทธิ์การใช้งานระบบสำนวนวินัยเท่านั้น</p>
        <details class="guide">
            <summary>คู่มือการเข้าสู่ระบบ</summary>
            <div class="guide-content">
                <ol>
                    <li>กรอกเฉพาะชื่อหน้าอีเมล BMA Mail เช่น <code>somchai</code></li>
                    <li>กรอกเลขประจำตัวประชาชน 13 หลักของเจ้าของบัญชี</li>
                    <li>กด “เข้าสู่ระบบ” ระบบจะตรวจสอบสิทธิ์ก่อนพาไปยังหน้าสำนวนวินัย</li>
                </ol>
                หากยังไม่มีบัญชี BMA Mail สามารถ <a href="https://register.bangkok.go.th/bmamailinfo/web/" target="_blank" rel="noopener">สมัครบัญชี BMA Mail</a>
            </div>
        </details>
    </form>
    <script src="{{ asset('assets/login.js') }}" defer></script>
    <form method="post" id="form-admin" class="tab-content{{ mode == 'admin' ? ' active' }}" {% if mode != 'admin' %}hidden{% endif %}>
        <input type="hidden" name="login_type" value="admin">
        <input type="hidden" name="csrf" value="{{ csrf_token('disc2_form') }}">
        <div class="field">
            <label for="local-username">Username</label>
            <input id="local-username" name="username" value="{{ mode == 'admin' ? username : '' }}" autocomplete="username" required>
        </div>
        <div class="field">
            <label for="local-password">Password</label>
            <input id="local-password" name="password" type="password" autocomplete="current-password" required>
        </div>
        <button class="btn" type="submit">เข้าสู่ระบบ</button>
    </form>
</main>
{% endif %}
{% endblock %}
